# Copy to config/deploy.local.env (gitignored) to choose how fred-public-data runs. Nothing here is required: without it,
# deploy/deploy.sh uses "dev". See docs/deployment.md.
#
#   dev   one run in the foreground, no systemd, no cluster
#   host  the systemd user timer runs the job on the host
#   k3s   the same timer triggers the job, which runs in a pod; its guards and post-steps stay on the host
FRED_DEPLOY_MODE=dev
